<configuration>
  <!-- Local development: colored console + rolling file appender.
       The FILE appender is inside this block so it is never instantiated in
       the cloud profiles (dev/uat/production), avoiding a FileNotFoundException
       for the logs/ directory which does not exist in the container. -->
  <springProfile name="!uat &amp; !production &amp; !dev">
    <property name="LOG_DIR" value="${LOG_DIR:-logs}" />
    <property name="LOG_FILE" value="${LOG_FILE:-application}" />

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
      <encoder>
        <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %highlight(%-5level) %cyan(%logger{36}) - %msg%n</pattern>
      </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
      <file>${LOG_DIR}/${LOG_FILE}-default-main.log</file>
      <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
        <fileNamePattern>${LOG_DIR}/archive/${LOG_FILE}-default-main.%d{yyyy-MM-dd}.%i.log.zip</fileNamePattern>
        <maxFileSize>5MB</maxFileSize>
        <maxHistory>30</maxHistory>
        <totalSizeCap>100MB</totalSizeCap>
      </rollingPolicy>
      <encoder>
        <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
      </encoder>
    </appender>

    <root level="INFO">
      <appender-ref ref="STDOUT" />
      <appender-ref ref="FILE" />
    </root>
  </springProfile>

  <!-- Cloud Run (dev/uat/production): structured JSON console only.
       Cloud Logging captures stdout; ANSI color codes render as \u001b noise.
       Use Spring Boot's structured encoder so Cloud Logging can promote
       severity and trace metadata from the JSON payload. -->
  <springProfile name="uat,production,dev">
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
      <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
        <format>${CONSOLE_LOG_STRUCTURED_FORMAT}</format>
        <charset>UTF-8</charset>
      </encoder>
    </appender>

    <root level="INFO">
      <appender-ref ref="STDOUT" />
    </root>
  </springProfile>
</configuration>
